<?xml version="1.0" encoding="utf-8"?>
<!--
  Только для отладочной сборки: разрешает обычный http куда угодно,
  чтобы можно было проверить приложение на настоящем телефоне,
  подключённом к той же сети, что и компьютер разработчика
  (адрес вида http://192.168.x.x:8000).

  Этот файл подменяет одноимённый из src/main и в релизную сборку
  не попадает — там http остаётся запрещённым.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
